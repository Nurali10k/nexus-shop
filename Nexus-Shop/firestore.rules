rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function activeUser() {
      return signedIn() && (!exists(profilePath()) || get(profilePath()).data.isActive != false);
    }
    function isAdmin() {
      return activeUser() && (
        request.auth.token.email == 'admin@nexus.com'
        || (exists(profilePath()) && get(profilePath()).data.role == 'admin')
      );
    }
    function owns(userId) { return activeUser() && request.auth.uid == userId; }
    function ownsOrder(orderId) {
      return activeUser()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }
    function ownsOrderAfter(orderId) {
      return activeUser()
        && existsAfter(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }
    function validProfileCreate(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email)
        && request.resource.data.role == (request.auth.token.email == 'admin@nexus.com' ? 'admin' : 'customer')
        && request.resource.data.isActive == true
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLoginAt', 'isActive', 'updatedAt']);
    }

    match /users/{uid} {
      allow get: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if activeUser() && request.auth.uid == uid && validProfileCreate(uid);
      allow update: if isAdmin() || (activeUser() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    match /addresses/{addressId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
    }
    match /wishlist/{uid} {
      allow read: if isAdmin() || owns(uid);
      allow create, update: if activeUser() && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 1000;
      allow delete: if isAdmin() || (activeUser() && request.auth.uid == uid);
    }
    match /user_preferences/{uid} {
      allow read, write: if isAdmin() || owns(uid);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin()
        && !('rating' in request.resource.data)
        && (!('avgRating' in request.resource.data) || request.resource.data.avgRating == 0)
        && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0);
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'avgRating', 'reviewCount']);
      allow delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_variants/{variantId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    match /cart_items/{cartItemId} {
      allow read, delete: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid
        && request.resource.data.quantity is int && request.resource.data.quantity > 0;
      allow update: if activeUser() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.quantity is int && request.resource.data.quantity > 0;
    }
    match /orders/{orderId} {
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /order_items/{orderItemId} {
      allow read: if isAdmin() || ownsOrder(resource.data.orderId);
      allow create: if ownsOrderAfter(request.resource.data.orderId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.quantity is int && request.resource.data.quantity > 0;
      allow update, delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || ownsOrder(resource.data.orderId);
      allow create: if ownsOrderAfter(request.resource.data.orderId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount == getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.total
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentId == paymentId
        && request.resource.data.method in ['card', 'cash', 'crypto'];
      allow update, delete: if isAdmin();
    }
    match /shipments/{shipmentId} {
      allow read: if isAdmin() || ownsOrder(resource.data.orderId);
      allow create: if ownsOrderAfter(request.resource.data.orderId)
        && request.resource.data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.shipmentId == shipmentId;
      allow update, delete: if isAdmin();
    }
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || ownsOrder(resource.data.orderId);
      allow write: if isAdmin();
    }
    match /returns_requests/{returnId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }
    match /review_votes/{voteId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow write: if false;
    }
    match /notifications/{notificationId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool);
      allow delete: if isAdmin();
    }
    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'updatedAt']));
      allow delete: if isAdmin();
    }
    match /activity_feed/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /settings/{settingId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    match /analytics_daily/{dayId} {
      allow read, write: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chat_messages/{messageId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid && request.resource.data.sender == 'user';
      allow update, delete: if isAdmin();
    }

  }
}
